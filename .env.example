# PostgreSQL connection string used by Prisma. Get this from your PostgreSQL provider
# or local PostgreSQL installation. Never commit a real password.
DATABASE_URL="postgresql://postgres:password@localhost:5432/kindred"

# Supabase Dashboard > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Supabase Dashboard > Project Settings > API > Publishable key (or legacy anon key).
# This is intentionally NEXT_PUBLIC_: it is safe for the browser when RLS is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# The local URL registered for Supabase Auth redirect URLs during development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"